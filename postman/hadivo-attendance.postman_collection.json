{
  "info": {
    "name": "Hadivo Attendance API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Endpoint Fase 1 untuk backend Hadivo Attendance System."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "tenantId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "packageId", "value": "22222222-2222-2222-2222-222222222201" },
    { "key": "billingPeriod", "value": "MONTHLY" },
    { "key": "paymentId", "value": "" },
    { "key": "providerOrderId", "value": "" },
    { "key": "grossAmount", "value": "99000.00" },
    { "key": "signatureKey", "value": "" },
    { "key": "midtransServerKey", "value": "local-midtrans-test-key" }
