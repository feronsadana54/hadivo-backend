# Copy ke .env dan sesuaikan untuk lokal kamu.
# Default value di sini cocok dengan docker/docker-compose.yml.

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hadivo
POSTGRES_USER=hadivo
POSTGRES_PASSWORD=hadivo

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=hadivo
RABBITMQ_PASSWORD=hadivo

# --- JWT ---
# Ganti dengan secret panjang (minimal 32 karakter) sebelum deploy.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# --- App ---
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Seed ---
# Password default user SUPER_ADMIN saat seed pertama kali.
SEED_SUPER_ADMIN_EMAIL=superadmin@hadivo.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
